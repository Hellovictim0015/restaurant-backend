# Server
PORT=5000
# Comma-separated browser origins allowed to call this API directly (CORS).
# Not needed when the admin panel calls through Next.js's /api rewrite.
CORS_ORIGINS=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=restaurant_db

# Must be the SAME value as restaurant-web's JWT_SECRET (Next.js verifies the
# admin cookie this server signs to guard /admin pages).
JWT_SECRET=replace-with-a-long-random-secret

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gmail SMTP — used to send customer login OTP codes.
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create an "App Password": https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESTAURANT_NAME=Royal Food Villa Restaurant
